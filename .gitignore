.env.newssra

# typescript
*.tsbuildinfo

# docker volume data (server)
/data/

# ไฟล์หลักฐานที่อัปโหลด (dev local — บน server เก็บผ่าน bind mount ./data/uploads แทน)
/uploads/

# แยกโปรเจกต์วิเคราะห์ข้อมูล (Python) — มีข้อมูลโรงเรียนดิบ ไม่เกี่ยวกับแอปหลัก
/ssra-policy-report/

# MCP task tooling / session data — ไม่ใช่ซอร์สของแอป
/mcps/

# Codex isolated feature worktrees
/.worktrees/

# Claude Code scheduled-task lock (pid/sessionId ของ process ปัจจุบัน)
/.claude/scheduled_tasks.lock

# dump ของฐานเดิมที่ดาวน์โหลดมา (ไฟล์ใหญ่ ไม่เก็บใน git)
/ssrainfo_ssra*.sql
/*.sql

# ข้อมูลจริงของระบบเดิมที่ export มาวิเคราะห์ (zip ตาราง legacy — มีข้อมูลสถานศึกษาจริงและตาราง `user`
# ที่รหัสผ่านเป็น plaintext) ห้ามหลุดเข้า git เด็ดขาด — ระบุเฉพาะระดับ root เพื่อไม่กระทบ zip/pdf ใน docs/
/legacy-tables-*.zip
/*.zip
/*.docx
/*.pdf

# DB dump ที่วางไว้ทำงานชั่วคราว — ห้ามเข้า git เด็ดขาด
# docs/newssra.sql มีตาราง `user` (รหัสผ่านโรงเรียนแบบ plaintext) และ docs/students.sql
# มีตาราง `students` ที่มีชื่อนักเรียนรายคน ซึ่งขัดกติกา PDPA ของระบบนี้โดยตรง
# (git history ลบยากมาก จึงกันตั้งแต่ต้นทาง ไม่ใช่มาลบทีหลัง)
docs/*.sql
