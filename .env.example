# คัดลอกเป็น .env.local สำหรับพัฒนาในเครื่อง (Laragon: root / รหัสผ่านว่าง)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=newssra

# ---- ระบบยืนยันตัวตน ----
# กุญแจลับสำหรับเซ็น session cookie (ต้องยาว >= 16 ตัว) — ตั้งค่าจริงบน production เสมอ
# สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=dev-insecure-secret-change-me

# รหัสผ่านเริ่มต้นของบัญชีผู้ดูแล (สร้างครั้งแรกที่แอปเชื่อมต่อฐานข้อมูล) เปลี่ยนได้ที่หน้า "จัดการผู้ใช้"
# หมายเหตุ: โรงเรียนเข้าสู่ระบบด้วยบัญชีเดิม (ตาราง `user` รหัส 8 หลัก) จึงไม่มี seed รหัสผ่านโรงเรียน
SEED_ADMIN_PASSWORD=admin123
SEED_SSRA_PASSWORD=ssra123

# ---- แผนที่ 3 มิติ (Cesium) ----
# ไม่จำเป็น — หน้า /map ทำงานแบบ keyless อยู่แล้ว (terrain Terrarium + ภาพ Esri)
# ใส่ค่านี้ถ้าต้องการใช้ Cesium ion terrain/imagery คุณภาพสูง (ต้องขึ้นต้นด้วย NEXT_PUBLIC_)
# NEXT_PUBLIC_CESIUM_ION_TOKEN=
# auto = ใช้ Google Maps ถ้ามี key, ถัดไป Cesium ion ถ้ามี token, ไม่อย่างนั้นใช้ Esri keyless
# ตั้งเป็น esri / google / ion เพื่อบังคับ provider เฉพาะ
NEXT_PUBLIC_MAP_IMAGERY_PROVIDER=auto
# ใช้ Google Photorealistic 3D Tiles (mesh 3 มิติจริง) เฉพาะ "ช่วงจับภาพ 3D ยืนยันที่ตั้ง" — ค่าเริ่มต้นปิด
# เปิดด้วย 1 หรือ true (ต้องมี Google key ที่เปิด Map Tiles API); เปิดเฉพาะช่วงจับภาพแล้วคืนสถานะทันที
# เพื่อไม่ให้กระทบค่าความสูงจาก terrain ที่ใช้คิดคะแนนมิติ 3 — ดู lib/map/photorealistic3d.ts
# ตรวจว่าพื้นที่เป้าหมายมี mesh จริงไหมก่อนเปิด: node scripts/probe-google-3dtiles.mjs <lat> <lng>
# NEXT_PUBLIC_MAP_3D_TILES=0
# ใส่ Google Maps API key ถ้าต้องการภาพถ่ายให้ใกล้ Google Maps ที่สุด + เปิดกล่องค้นหาสถานที่ (autocomplete)
# ต้องเปิดใช้ API เหล่านี้บน key และอนุญาต HTTP referrer ของโดเมนที่ใช้งาน:
#   • Map Tiles API                     → ภาพถ่ายดาวเทียม (imagery)
#   • Maps JavaScript API + Places API  → กล่องค้นหาสถานที่ (Google Places Autocomplete)
# ถ้าไม่มี key/API ไม่ครบ กล่องค้นหาจะ fallback ไปใช้ Nominatim/OpenStreetMap (keyless) อัตโนมัติ
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- เส้นทางถนน (OSRM) ----
# host ของ OSRM ที่ใช้คำนวณเส้นทาง/ระยะเวลาบนแผนที่ (ตัดผ่านฝั่ง client จึงต้องขึ้นต้น NEXT_PUBLIC_)
# ค่าเริ่มต้นคือ demo server สาธารณะ (router.project-osrm.org) — ฟรี ไม่ต้องมี key แต่ไม่รับประกัน uptime
# สำหรับใช้งานจริงควร self-host OSRM แล้วชี้มาที่ instance นั้น เช่น NEXT_PUBLIC_OSRM_URL=https://osrm.example.com
# NEXT_PUBLIC_OSRM_URL=

# ---- เส้นทางเดินเท้า (ต่อท้ายเมื่อถนนเข้าไม่ถึงโรงเรียน) ----
# โรงเรียนพื้นที่ห่างไกลบางแห่งต้อง "ขับรถถึงปลายถนน แล้วเดินต่อ" ซึ่ง profile รถมองไม่เห็นทางเดิน
# ตั้งค่านี้เพื่อให้ระบบหาช่วงเดินเท้าต่อให้ แล้วรวมเวลาเข้าข้อ 3.1 (ไม่ตั้ง = ปิดฟีเจอร์ ไม่มีผลข้างเคียง)
#
# ⚠️ ห้ามชี้ไป https://router.project-osrm.org — demo server ตอบ /route/v1/foot/ ด้วยกราฟรถคันเดิม
#    ผลที่ได้ "ดูเหมือนสำเร็จ" แต่ผิด (วัดจริงได้ 0.5 ม.) ต้องเป็น instance ที่รัน profile เดินเท้าจริง
# ควร self-host คู่กับ OSRM ของรถ — instance ชุมชน (routing.openstreetmap.de) ห้ามใช้ production ตาม ToS
# NEXT_PUBLIC_OSRM_FOOT_URL=
# ชื่อ profile บน host นั้น (ค่าเริ่มต้น foot; บาง instance ใช้ walking)
# NEXT_PUBLIC_OSRM_FOOT_PROFILE=foot
