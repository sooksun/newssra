# คัดลอกไฟล์นี้เป็น .env.production บนเซิร์ฟเวอร์ แล้วกรอกรหัสผ่านเอง
# (ไฟล์ .env.production ถูก gitignore — ไม่ถูก commit)

# ---- ค่าเชื่อมต่อของแอป (Next.js) ----
# ใช้ service db ใน docker-compose → DB_HOST=db
# ใช้ MySQL บนเครื่อง host → DB_HOST=host.docker.internal
DB_HOST=db
DB_PORT=3306
DB_NAME=newssra
DB_USER=newssra
DB_PASSWORD=

# ---- ระบบยืนยันตัวตน (บังคับตั้งค่าบน production) ----
# กุญแจลับเซ็น session cookie — ต้องยาว >= 16 ตัว และเก็บเป็นความลับ
# ⚠️ บน production แอปจะ "ปฏิเสธการทำงาน" (throw) ถ้าไม่ได้ตั้งค่านี้ หรือใช้ค่า default — ต้องตั้งจริงเสมอ
# สร้าง: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# รหัสผ่านเริ่มต้นของบัญชีผู้ดูแล admin / ssra_admin — ต้องยาว >= 6 ตัว เปลี่ยนทันทีหลังติดตั้ง
# ถ้าเว้นว่างบน production แอปจะ "สุ่มรหัสให้อัตโนมัติแล้วพิมพ์ลง log ครั้งเดียว" (อ่านจาก log ของคอนเทนเนอร์)
# (โรงเรียนเข้าสู่ระบบด้วยบัญชีเดิมในตาราง `user` — ไม่มี seed รหัสผ่านโรงเรียน)
SEED_ADMIN_PASSWORD=
SEED_SSRA_PASSWORD=

# ---- แผนที่ 3 มิติ (Cesium) — ไม่จำเป็น (หน้า /map เป็น keyless อยู่แล้ว) ----
# ใส่ถ้าต้องการใช้ Cesium ion terrain/imagery คุณภาพสูง
# NEXT_PUBLIC_CESIUM_ION_TOKEN=
NEXT_PUBLIC_MAP_IMAGERY_PROVIDER=auto
# ใส่ Google Maps API key ที่เปิดใช้ Map Tiles API ถ้าต้องการภาพถ่ายให้ใกล้ Google Maps ที่สุด
# กล่องค้นหาสถานที่ (Google Places Autocomplete) ใช้ key เดียวกันนี้ — ต้องเปิด Maps JavaScript API + Places API
# และอนุญาต HTTP referrer ของโดเมน; ไม่มี key จะ fallback ไป Nominatim/OpenStreetMap (keyless)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- เส้นทางถนน (OSRM) ----
# host ของ OSRM สำหรับคำนวณเส้นทาง/ระยะเวลาบนแผนที่ (NEXT_PUBLIC_ เพราะเรียกจากฝั่ง client)
# ค่าเริ่มต้น = demo server สาธารณะ (ไม่รับประกัน uptime) — production ควร self-host แล้วชี้มาที่ instance นั้น
# NEXT_PUBLIC_OSRM_URL=https://osrm.example.com

# ---- ค่าของ MySQL container (service db) — ให้ตรงกับด้านบน ----
MYSQL_DATABASE=newssra
MYSQL_USER=newssra
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# AI วิเคราะห์ภูมิประเทศจากภาพ 3D (OpenRouter + Gemini 2.5 Flash) — ถ้าไม่ตั้ง ฟีเจอร์นี้จะปิดอย่างสุภาพ
OPENROUTER_API_KEY=
# ไม่บังคับ — เปลี่ยนรุ่นโมเดล (ค่าเริ่มต้น google/gemini-2.5-flash)
# AI_TERRAIN_MODEL=google/gemini-2.5-flash
