# ---- การเชื่อมต่อฐานข้อมูลเดิม ssrainfo_ssra (อ่านอย่างเดียว) ----
# คัดลอกไฟล์นี้เป็น .env.newssra แล้วเติมค่าจริง — .env.newssra ถูก gitignore ไว้แล้ว
# ห้ามใส่รหัสผ่านจริงในไฟล์ .example นี้ (ไฟล์นี้ถูก commit ลง git)
# ใช้โดย: scripts/analyze-legacy-items.mjs (ผ่าน scripts/legacy-db.mjs)
#
# ถ้าไม่มีไฟล์ .env.newssra สคริปต์จะใช้ snapshot ในเครื่อง (127.0.0.1 / ssra_hist) แทน

LEGACY_DB_HOST=www.ssra.info
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=ssrainfo_ssra
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=

# ตั้ง 1 ถ้าเซิร์ฟเวอร์บังคับ TLS
LEGACY_DB_SSL=0
# หมดเวลาเชื่อมต่อ (มิลลิวินาที)
LEGACY_DB_TIMEOUT_MS=15000

# ถ้าต่อฐานจริงไม่ได้ สคริปต์จะถอยไปใช้ snapshot ในเครื่องให้อัตโนมัติพร้อมคำเตือน
# ตั้ง 1 ถ้าอยากให้ล้มเหลวไปเลยแทนการถอย (เช่น ตอนรันใน CI)
LEGACY_DB_STRICT=0

# ค่าเชื่อมต่อ snapshot ในเครื่อง (ใช้ตอน fallback) — นำเข้าจาก dump ของฐานเดิม
LEGACY_SNAPSHOT_NAME=ssra_hist
LEGACY_SNAPSHOT_USER=root
LEGACY_SNAPSHOT_PASSWORD=
